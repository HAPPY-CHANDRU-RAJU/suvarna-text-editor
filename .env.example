# Copy to .env and fill in what you need. Everything is optional:
# with nothing set, Suvarna runs in local mode (documents in this browser,
# built-in offline spell check).

# --- Cloud accounts, documents and share links (Supabase) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Language API used by "Suvarna Cloud AI" ---
# Leave empty to use the Supabase Edge Function at $VITE_SUPABASE_URL/functions/v1/language.
# Point at the local server for development:  VITE_LANGUAGE_API_URL=http://localhost:8787
VITE_LANGUAGE_API_URL=

# --- Per-word spell-check API (Custom API → "One word per request") ---
# POST {"word": "wanner"} → {"body": ["winner", …]}. Sets the default provider
# for new browsers; users can still change it in Review → Language Services.
# In development, route it through Vite's proxy to avoid CORS:
#   LANGUAGE_PROXY_TARGET=http://localhost:9001
#   VITE_SPELLCHECK_URL=/language-proxy/spellcheck
VITE_SPELLCHECK_URL=
LANGUAGE_PROXY_TARGET=

# --- Local language server (npm run language-api); never exposed to the browser ---
ANTHROPIC_API_KEY=
# LANGUAGE_MODEL=claude-opus-5-5
# LANGUAGE_API_PORT=8787
# ALLOWED_ORIGIN=http://localhost:8080
